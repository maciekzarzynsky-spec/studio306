---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero   from "../components/Hero.astro";
import TrustedBy from "../components/TrustedBy.astro";
import WhyStudio306 from"../components/WhyStudio306.astro";
import Offer from "../components/Offer.astro";
import Projects from "../components/Projects.astro";
import Production from "../components/Production.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>

	<Navbar />
	<main class="home-content">
	<Hero />
	<TrustedBy />
	<WhyStudio306 />
	<Offer />
	<Projects />
	<Production />
	<Contact />
	</main>
	<Footer />

</Layout>
<style>
@media (max-width: 700px) {
 .home-content { display: flex; flex-direction: column; }
 .home-content :global(.hero) { order: -2; }
 .home-content :global(.offer) { order: -1; }
}
</style>
