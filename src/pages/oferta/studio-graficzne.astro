---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const services = [
  {
    number: "01",
    title: "Skład DTP",
    text: "Przygotowanie materiałów do druku i uporządkowanie projektu przed produkcją.",
  },
  {
    number: "02",
    title: "Identyfikacja wizualna",
    text: "System wizualny marki — od podstawowych założeń po materiały wykorzystywane na co dzień.",
  },
  {
    number: "03",
    title: "Projektowanie okładek",
    text: "Projekty okładek i materiałów wydawniczych łączące funkcję z charakterem publikacji.",
  },
  {
    number: "04",
    title: "Projekty niestandardowe",
    text: "Rozwiązania tworzone dla pomysłów, które nie mieszczą się w gotowych schematach.",
  },
];
---

<Layout>
  <Navbar />

  <main>

    <!-- HERO -->

    <section class="hero">
      <div class="container">
        <div class="hero-meta reveal">
          <span>04 / OFERTA</span>
          <span>STUDIO GRAFICZNE</span>
        </div>

        <div class="hero-grid">
          <div class="hero-heading reveal">
            <h1>
              Pomysł zaczyna<br />
              się od kreski.
            </h1>
          </div>

          <div class="hero-copy reveal">
            <p>
              Projektujemy materiały, identyfikacje i niestandardowe
              formy wizualne. Od pierwszego pomysłu po plik gotowy
              do produkcji.
            </p>

            <a href="/kontakt">
              Porozmawiajmy o projekcie
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CREATIVE COMPOSITION -->

    <section class="creative">
      <div class="container creative-grid">

        <div class="visual visual-large reveal">
          <span class="visual-label">Projekt / realizacja 01</span>
        </div>

        <div class="statement reveal">
          <span class="label">Studio 306 / Design</span>

          <p>
            Dobry projekt nie zaczyna się od programu.
            Zaczyna się od pomysłu.
          </p>
        </div>

        <div class="visual visual-small reveal">
          <span class="visual-label">Projekt / realizacja 02</span>
        </div>

      </div>
    </section>

    <!-- SERVICES -->

    <section class="services">
      <div class="container">

        <div class="services-head reveal">
          <span class="label">Zakres pracy</span>

          <h2>
            Projektujemy.<br />
            Przygotowujemy.<br />
            Produkujemy.
          </h2>
        </div>

        <div class="services-list">
          {
            services.map((service) => (
              <article class="service reveal">
                <span class="service-number">{service.number}</span>

                <h3>{service.title}</h3>

                <p>{service.text}</p>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- SECOND VISUAL -->

    <section class="showcase">
      <div class="container showcase-grid">

        <div class="showcase-copy reveal">
          <span class="label">Od idei do realizacji</span>

          <h2>
            Projekt nie kończy się
            na ekranie.
          </h2>

          <p>
            Studio graficzne działa razem z produkcją Studio 306.
            Dzięki temu projekt może od razu zostać przygotowany
            do konkretnej technologii i finalnej realizacji.
          </p>
        </div>

        <div class="visual visual-tall reveal">
          <span class="visual-label">Projekt / realizacja 03</span>
        </div>

      </div>
    </section>

    <!-- PROCESS -->

    <section class="process">
      <div class="container">

        <div class="process-head reveal">
          <span class="label">Proces</span>
          <h2>Od pomysłu do gotowego projektu.</h2>
        </div>

        <div class="steps">

          <div class="step reveal">
            <span>01</span>
            <strong>Pomysł</strong>
          </div>

          <div class="step reveal">
            <span>02</span>
            <strong>Projekt</strong>
          </div>

          <div class="step reveal">
            <span>03</span>
            <strong>Przygotowanie</strong>
          </div>

          <div class="step reveal">
            <span>04</span>
            <strong>Produkcja</strong>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->

    <section class="cta">
      <div class="container cta-inner reveal">

        <div>
          <span class="label">Masz pomysł?</span>

          <h2>
            Nadajmy mu<br />
            formę.
          </h2>
        </div>

        <a href="/kontakt">
          Napisz do nas
          <span>↗</span>
        </a>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>

  :global(body) {
    margin: 0;
    background: #f7f6f3;
    color: #111;
  }

  main {
    overflow: hidden;
  }

  .container {
    width: min(1160px, calc(100% - 96px));
    margin: 0 auto;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .label {
    display: block;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  /* HERO */

  .hero {
    padding: 72px 0 90px;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;

    padding-bottom: 16px;

    border-bottom: 1px solid #c7c5bf;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 0.12em;
  }

  .hero-grid {
    display: grid;

    grid-template-columns: 1.25fr 0.75fr;

    gap: 90px;

    align-items: end;

    padding-top: 62px;
  }

  h1 {
    margin-bottom: 0;

    font-size: clamp(52px, 5vw, 76px);

    line-height: 0.96;

    letter-spacing: -0.055em;
  }

  .hero-copy {
    padding-bottom: 4px;
  }

  .hero-copy p {
    max-width: 420px;

    margin-bottom: 32px;

    color: #555;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 15px;

    line-height: 1.65;
  }

  .hero-copy a {
    display: inline-flex;

    align-items: center;

    gap: 22px;

    padding-bottom: 6px;

    border-bottom: 1px solid currentColor;

    color: #111;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;
  }

  .hero-copy a span {
    transition: transform 180ms ease;
  }

  .hero-copy a:hover span {
    transform: translate(4px, -4px);
  }

  /* CREATIVE */

  .creative {
    padding: 20px 0 120px;
  }

  .creative-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(220px, 0.55fr)
      minmax(0, 0.75fr);

    gap: 28px;

    align-items: start;
  }

  .visual {
    position: relative;

    background: #dedcd5;
  }

  .visual-large {
    min-height: 560px;
  }

  .visual-small {
    min-height: 355px;

    margin-top: 120px;
  }

  .visual-label {
    position: absolute;

    left: 16px;
    bottom: 14px;

    color: #666;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 9px;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .statement {
    padding-top: 70px;
  }

  .statement .label {
    margin-bottom: 25px;
  }

  .statement p {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;

    font-size: clamp(24px, 2.3vw, 34px);

    line-height: 1.1;

    letter-spacing: -0.035em;
  }

  /* SERVICES */

  .services {
    padding: 105px 0 115px;

    background: #fff;
  }

  .services-head {
    display: grid;

    grid-template-columns: 0.6fr 1.4fr;

    gap: 80px;

    align-items: start;

    margin-bottom: 65px;
  }

  .services-head h2 {
    max-width: 680px;
  }

  h2 {
    margin-bottom: 0;

    font-size: clamp(40px, 4vw, 60px);

    line-height: 1;

    letter-spacing: -0.05em;
  }

  .services-list {
    border-top: 1px solid #c7c5bf;
  }

  .service {
    display: grid;

    grid-template-columns:
      60px
      minmax(220px, 0.8fr)
      minmax(280px, 1.2fr);

    gap: 30px;

    align-items: start;

    padding: 24px 0 28px;

    border-bottom: 1px solid #c7c5bf;
  }

  .service-number {
    color: #888;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 9px;
  }

  .service h3 {
    margin: 0;

    font-size: clamp(24px, 2.2vw, 32px);

    letter-spacing: -0.04em;

    line-height: 1;
  }

  .service p {
    max-width: 470px;

    margin: 0;

    color: #666;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 13px;

    line-height: 1.6;
  }

  /* SHOWCASE */

  .showcase {
    padding: 115px 0;
  }

  .showcase-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 0.85fr)
      minmax(0, 1.15fr);

    gap: 110px;

    align-items: center;
  }

  .showcase-copy .label {
    margin-bottom: 24px;
  }

  .showcase-copy h2 {
    max-width: 520px;

    margin-bottom: 28px;
  }

  .showcase-copy p {
    max-width: 470px;

    margin-bottom: 0;

    color: #616161;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 14px;

    line-height: 1.65;
  }

  .visual-tall {
    min-height: 610px;
  }

  /* PROCESS */

  .process {
    padding: 95px 0;

    background: #e9e7e1;
  }

  .process-head {
    margin-bottom: 52px;
  }

  .process-head .label {
    margin-bottom: 17px;
  }

  .steps {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    border-top: 1px solid #bbb;
  }

  .step {
    min-height: 130px;

    padding: 17px 18px 20px 0;

    display: flex;
    flex-direction: column;

    justify-content: space-between;

    border-right: 1px solid #bbb;
  }

  .step + .step {
    padding-left: 18px;
  }

  .step:last-child {
    border-right: 0;
  }

  .step span {
    color: #777;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 9px;
  }

  .step strong {
    font-family: Arial, Helvetica, sans-serif;

    font-size: 13px;
  }

  /* CTA */

  .cta {
    padding: 90px 0;

    background: #111;

    color: #f7f6f3;
  }

  .cta-inner {
    display: flex;

    justify-content: space-between;

    align-items: flex-end;

    gap: 60px;
  }

  .cta .label {
    margin-bottom: 17px;

    color: #aaa;
  }

  .cta h2 {
    font-size: clamp(44px, 4.5vw, 66px);
  }

  .cta a {
    display: inline-flex;

    align-items: center;

    gap: 22px;

    flex: 0 0 auto;

    padding-bottom: 7px;

    border-bottom: 1px solid currentColor;

    color: #fff;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;
  }

  .cta a span {
    transition: transform 180ms ease;
  }

  .cta a:hover span {
    transform: translate(4px, -4px);
  }

  /* REVEAL */

  .reveal {
    opacity: 0;

    transform: translateY(18px);

    transition:
      opacity 600ms ease,
      transform 600ms ease;
  }

  .reveal.is-visible {
    opacity: 1;

    transform: translateY(0);
  }

  /* TABLET */

  @media (max-width: 900px) {

    .container {
      width: min(100% - 48px, 1160px);
    }

    .hero-grid {
      grid-template-columns: 1fr;

      gap: 42px;
    }

    .creative-grid {
      grid-template-columns: 1fr 0.7fr;
    }

    .statement {
      grid-column: 1 / -1;

      max-width: 500px;

      padding-top: 0;
    }

    .visual-small {
      margin-top: 70px;
    }

    .services-head {
      grid-template-columns: 1fr;

      gap: 30px;
    }

    .service {
      grid-template-columns: 45px 0.8fr 1.2fr;
    }

    .showcase-grid {
      grid-template-columns: 1fr;

      gap: 60px;
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .step:nth-child(2) {
      border-right: 0;
    }

    .step:nth-child(3),
    .step:nth-child(4) {
      border-top: 1px solid #bbb;
    }

  }

  /* MOBILE */

  @media (max-width: 560px) {

    .container {
      width: calc(100% - 40px);
    }

    .hero {
      padding: 52px 0 70px;
    }

    .hero-grid {
      padding-top: 42px;
    }

    h1 {
      font-size: clamp(46px, 13vw, 62px);
    }

    .creative {
      padding-bottom: 80px;
    }

    .creative-grid {
      grid-template-columns: 1fr;
    }

    .visual-large {
      min-height: 400px;
    }

    .visual-small {
      min-height: 300px;

      margin-top: 0;
    }

    .statement {
      padding: 30px 0;
    }

    .services {
      padding: 75px 0;
    }

    .service {
      grid-template-columns: 35px 1fr;

      gap: 15px;
    }

    .service p {
      grid-column: 2;

      margin-top: 8px;
    }

    .showcase {
      padding: 75px 0;
    }

    .visual-tall {
      min-height: 390px;
    }

    .process {
      padding: 70px 0;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .step,
    .step + .step {
      min-height: 95px;

      padding: 18px 0;

      border-top: 1px solid #bbb;

      border-right: 0;
    }

    .step:first-child {
      border-top: 0;
    }

    .cta {
      padding: 70px 0;
    }

    .cta-inner {
      flex-direction: column;

      align-items: flex-start;
    }

  }

</style>

<script>
  const revealElements = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.1,
    }
  );

  revealElements.forEach((element) => {
    observer.observe(element);
  });
</script>