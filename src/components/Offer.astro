---
import { assetUrl as siteUrl } from "../lib/assetUrl";
const categories = [
  {
    number: "01",
    title: "Druk wielkoformatowy",
    items: [
      "Folie reklamowe",
      "Banery i siatki",
      "Roll-upy",
      "Tapety i fototapety",
    ],
    href: "/oferta/druk-wielkoformatowy"
  },
  {
    number: "02",
    title: "Reklama zewnętrzna",
    items: [
      "Konstrukcje reklamowe",
      "Powierzchnie wielkoformatowe",
      "Montaże alpinistyczne",
      "Kasetony reklamowe",
    ],
    href: "/oferta/reklama-zewnetrzna"
  },
  {
    number: "03",
    title: "Druk cyfrowy",
    items: [
      "Plakaty",
      "Ulotki",
      "Foldery",
      "Katalogi",
    ],
    href: "/oferta/druk-cyfrowy"
  },
  {
    number: "04",
    title: "Studio graficzne",
    items: [
      "Skład DTP",
      "Identyfikacja wizualna",
      "Projektowanie",
      "Projekty niestandardowe"
    ],
    href: "/oferta/studio-graficzne"
  }
];
---

<section class="offer" id="oferta">

  <div class="offer-heading">
    <span class="eyebrow">OFERTA</span>

    <h2>
      Od projektu<br />
      po montaż.
    </h2>

    <p>
      Wszystko, czego potrzebujesz do skutecznej reklamy
      w jednym miejscu.
    </p>
  </div>

  <div class="offer-grid">

    {categories.map(category => (

      <a href={siteUrl(`${category.href}/`)} class="offer-card">

        <div class="offer-top">
          <span>{category.number}</span>
          <span>↗</span>
        </div>

        <h3>{category.title}</h3>

        <ul>
          {category.items.map(item => (
            <li>{item}</li>
          ))}
        </ul>

        <div class="offer-more">
          Poznaj ofertę
          <span>→</span>
        </div>

      </a>

    ))}

  </div>

</section>

<style>
  .offer {
    padding: 120px clamp(24px, 6vw, 96px);
    background: #f7f6f3;
  }

  .offer-heading,
  .offer-grid {
    max-width: 1100px;
    margin-inline: auto;
  }

  .offer-heading {
    margin-bottom: 56px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 18px;
    color: #555;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .offer-heading h2 {
    max-width: 760px;
    margin: 0;
    color: #111;
    font-size: clamp(3rem, 5vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .offer-heading p {
    max-width: 560px;
    margin: 28px 0 0;
    color: #555;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .offer-card {
    position: relative;
    min-height: 440px;

    display: flex;
    flex-direction: column;

    padding: 32px;

    overflow: hidden;

    border: 1px solid #e2e2e2;
    border-radius: 2px;

    background: #fff;
    color: #111;
    text-decoration: none;

    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

.offer-card:hover {
  transform: translateY(-6px);

  background: #fcfcfc;

  border-color: #111;

  box-shadow:
    0 20px 50px rgba(0,0,0,.06);
}

  .offer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 28px;

    font-size: 1rem;
    font-weight: 700;
  }

  .offer-top span:last-child {
    font-size: 1.7rem;
    line-height: 1;

    transition: transform 0.35s ease;
  }

  .offer-card:hover .offer-top span:last-child {
    transform: translate(6px,-6px);
  }

  .offer-card h3 {
    max-width: 430px;
    margin: 0 0 32px;

    font-size: clamp(1.8rem, 2.2vw, 2.55rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .offer-card ul {
  display: grid;
  gap: 10px;

  margin: 0;
  padding: 0;

  list-style: none;

  color: #666;
  font-size: 1.08rem;
  font-weight: 500;
  line-height: 1.55;
}

  .offer-card li {
    position: relative;
    padding-left: 18px;
  }

  .offer-card li::before {
    content: "";

    position: absolute;
    top: 0.68em;
    left: 0;

    width: 8px;
    height: 2px;

    background: currentColor;
  }

.offer-more {
  margin-top: auto;
  padding-top: 24px;
  padding-bottom: 8px;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  width: fit-content;

  color: #111;
  font-size: 0.95rem;
  font-weight: 700;
}

.offer-more .arrow {
  transition: transform .25s ease;
}

.offer-card:hover .offer-more .arrow {
  transform: translateX(6px);
}

  @media (max-width: 820px) {
    .offer {
      padding-block: 88px;
    }

    .offer-grid {
      grid-template-columns: 1fr;
    }

    .offer-card {
      min-height: 440px;
    }
  }

  @media (max-width: 560px) {
    .offer {
      padding-inline: 20px;
    }

    .offer-heading {
      margin-bottom: 48px;
    }

    .offer-heading h2 {
      font-size: clamp(2.7rem, 13vw, 4rem);
    }

    .offer-card {
      min-height: 420px;
      padding: 24px;
    }

    .offer-top {
      margin-bottom: 52px;
    }

    .offer-top span:first-child{
    color:#777;
}
  }

@media (max-width: 700px) {

.offer { padding: 36px 20px 44px; }
.offer-heading { margin-bottom: 12px; }
.eyebrow { color: #111; font-size: 2.25rem; font-weight: 700; letter-spacing: -.04em; text-transform: none; margin: 0; }
.offer-heading h2, .offer-heading p { display: none; }
.offer-grid { gap: 0; }
.offer-card { background: transparent; box-sizing: border-box; display: grid; grid-template-columns: minmax(0,1fr) 24px; align-items: center; min-height: 80px; padding: 18px 0; border: 0; border-bottom: 1px solid #ddd; border-radius: 0; overflow: visible; }
.offer-card h3 { grid-area: 1 / 1; font-size: clamp(1.2rem, 5.3vw, 1.55rem); line-height: 1.15; margin: 0; letter-spacing: -.025em; }
.offer-top { grid-area: 1 / 2; margin: 0; }
.offer-top span:first-child, .offer-card ul, .offer-more { display: none; }
.offer-card:hover { background: transparent; transform: none; box-shadow: none; }

}
</style>