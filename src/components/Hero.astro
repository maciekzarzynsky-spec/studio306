---
import { assetUrl } from "../lib/assetUrl";
---

<section class="hero">
	<div class="hero-grid">
		<div class="hero-content">
			<h1>
				Sprawiamy,<br />
				że Twoją firmę<br />
				widać.
			</h1>

			<p>
				Projektujemy, produkujemy i montujemy reklamy dla firm w całej Polsce.
			</p>

			<div class="buttons">
				<a href="#kontakt" class="cta cta-primary">Wyceń projekt <span>→</span></a>
				<a href="#realizacje" class="cta cta-secondary">Zobacz realizacje <span>→</span></a>
			</div>

			<div class="benefits" aria-label="Najważniejsze etapy współpracy">
				<div class="benefit">
					<div class="benefit-icon">✒</div>
					<h3>Projekt</h3>
					<p>Tworzymy przemyślane projekty, które przyciągają uwagę.</p>
				</div>

				<div class="benefit">
					<div class="benefit-icon">▣</div>
					<h3>Produkcja</h3>
					<p>Nowoczesny park maszynowy i materiały wysokiej jakości.</p>
				</div>

				<div class="benefit">
					<div class="benefit-icon">⌁</div>
					<h3>Montaż</h3>
					<p>Profesjonalny montaż w całej Polsce. Szybko i bezpiecznie.</p>
				</div>
			</div>
		</div>

		<div class="hero-media">
			<video
				class="hero-video"
				autoplay
				muted
				loop
				playsinline>
				<source src={assetUrl("video/hero.mp4")} type="video/mp4" />
			</video>
		</div>
	</div>
</section>

<style>
.hero {
	min-height: calc(100vh - 96px);
	padding: 96px 0 12px;
	background: #f5f5f5;
	overflow: hidden;
}

.hero-grid {
	width: min(1440px, 94%);
	padding-left: 48px;
	margin: 0 auto;
	display: grid;
	grid-template-columns: minmax(560px, 0.9fr) minmax(640px, 1.1fr);
	align-items: center;
	gap: 56px;
}

.hero-content {
	position: relative;
	z-index: 2;
}

h1 {
	font-size: clamp(4.5rem, 5vw, 6.2rem);
	line-height: 0.92;
	letter-spacing: -0.055em;
	margin: 0 0 32px;
	max-width: 680px;
}

.hero-content > p {
	font-size: clamp(1.1rem, 1.3vw, 1.35rem);
	line-height: 1.5;
	color: #4b4b4b;
	margin: 0 0 36px;
	max-width: 520px;
}

.buttons {
	display: flex;
	gap: 18px;
	flex-wrap: wrap;
	margin-bottom: 72px;
}

.cta {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 28px;
	min-width: 210px;
	padding: 16px 26px;
	border: 2px solid #111;
	border-radius: 999px;
	text-decoration: none;
	font-weight: 700;
	transition: 0.25s ease;
}

.cta-primary {
	background: #111;
	color: #fff;
}

.cta-primary:hover {
	background: transparent;
	color: #111;
}

.cta-secondary {
	color: #111;
	background: transparent;
}

.cta-secondary:hover {
	background: #111;
	color: #fff;
}

.benefits {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 0;
	max-width: 720px;
}

.benefit {
	padding-right: 32px;
}

.benefit + .benefit {
	border-left: 1px solid #d3d3d3;
	padding-left: 32px;
}

.benefit-icon {
	font-size: 28px;
	line-height: 1;
	margin-bottom: 22px;
}

.benefit h3 {
	font-size: 1.1rem;
	margin: 0 0 14px;
}

.benefit p {
	font-size: 0.9rem;
	line-height: 1.45;
	color: #555;
	margin: 0;
}

.hero-media {
	height: 720px;
	width: calc(100% + 8vw);
	border-top-left-radius: 120px;
	border-bottom-left-radius: 120px;
	background:
		linear-gradient(90deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0)),
		linear-gradient(135deg, #1d1d1d, #777 45%, #111);
	box-shadow: -24px 28px 70px rgba(0, 0, 0, 0.16);
	overflow: hidden;
	position: relative;
}

.hero-video {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	object-position: center center;
	display: block;
	border-top-left-radius: inherit;
	border-bottom-left-radius: inherit;
}

@media (max-width: 1100px) {
	.hero-grid {
		grid-template-columns: 1fr;
	}

	.hero-media {
		width: 100%;
		min-height: 420px;
		border-radius: 40px;
		order: -1;
	}

	.benefits {
		grid-template-columns: 1fr;
		gap: 28px;
	}

	.benefit,
	.benefit + .benefit {
		border-left: 0;
		padding: 0;
	}
}

@media (max-width: 700px) {
	.hero {
		padding: 56px 0 64px;
	}

	h1 {
		font-size: clamp(3.2rem, 15vw, 4.5rem);
	}

	.buttons {
		margin-bottom: 48px;
	}

	.cta {
		width: 100%;
	}
}

@media (max-width: 700px) {

.hero { min-height: 0; padding: 0; background: #161616; }
.hero-grid { width: 100%; padding: 0; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; isolation: isolate; }
.hero-content, .hero-media { grid-area: 1 / 1; }
.hero-media { order: 0; width: 100%; height: 100%; min-height: 0; border-radius: 0; box-shadow: none; z-index: -2; }
.hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.30), rgba(0,0,0,.72) 65%, rgba(0,0,0,.80)); }
.hero-video { border-radius: 0; object-position: 55% center; }
.hero-content { box-sizing: border-box; min-width: 0; min-height: 510px; padding: 100px 24px 36px; display: flex; flex-direction: column; justify-content: flex-end; color: #fff; }
h1 { font-size: clamp(2.6rem, 11vw, 3.7rem); line-height: 1.02; letter-spacing: -.045em; margin: 0 0 22px; }
.hero-content > p { color: #fff; font-size: 1rem; line-height: 1.5; margin: 0 0 26px; max-width: 34ch; }
.buttons { gap: 16px; margin: 0; align-items: flex-start; flex-direction: column; }
.cta { box-sizing: border-box; min-width: 0; width: auto; font-size: 1rem; padding: 14px 24px; }
.cta-primary { color: #111; background: #fff; border-color: #fff; }
.cta-primary:hover { color: #111; background: #eee; }
.cta-secondary { color: #fff; border: 0; border-radius: 0; padding: 4px 0; min-height: 44px; text-decoration: underline; text-underline-offset: 6px; }
.cta-secondary:hover { background: transparent; }
.benefits { display: none; }

}
</style>