---
const steps = [
    {
        number: "01",
        title: "Konsultacja",
        description:
            "Poznajemy Twoje potrzeby i doradzamy najlepsze rozwiązanie."
    },
    {
        number: "02",
        title: "Projekt",
        description:
            "Przygotowujemy projekt dopasowany do Twojej marki i przestrzeni."
    },
    {
        number: "03",
        title: "Produkcja",
        description:
            "Realizujemy projekty w naszym nowoczesnym parku maszynowym."
    },
    {
        number: "04",
        title: "Dostawa",
        description:
        "Bezpiecznie transportujemy gotowe materiały na miejsce."
    },
    {
        number: "05",
        title: "Montaż",
        description:
        "Profesjonalnie montujemy reklamę i dbamy o każdy detal."
    }

];
---

<section id="o-nas" class="why-studio">
    <div class="section-heading">
        <span>Dlaczego Studio 306?</span>
        <h2>Od pierwszej rozmowy<br/>do gotowego montażu.</h2>
        <p>Przejmujemy cały proces: doradzamy, projektujemy, produkujemy, dostarczamy i montujemy reklamę na miejscu.</p>
    </div>

    <div class="steps">
        {steps.map((step) => (
            <article class="step">

                <div class="step-marker">
                <span class="step-number">{step.number}</span>
                </div>

                <div class="step-content">
                <h3>{step.title}</h3>
                <p>{step.description}</p>
            </div>
        </article>
        ))}
    </div>
    </section>

    <style>

    .why-studio {
        padding: 120px clamp(24px, 6vw, 96px);
        background: #f7f6f3;
    }

    .section-heading {
        max-width: 1100px;
        margin: 0 auto 96px;
    }

    .section-heading span {
        display: block;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #555;
        margin-bottom: 18px;
    }

    .section-heading h2 {
        max-width: 820px;
        margin: 0;
        font-size: clamp(2.8rem, 4.5vw, 4.8rem);
        line-height: 0.95;
        letter-spacing: -0.055em;
        color: #111;
    }

    .section-heading p {
        max-width: 560px;
        margin: 28px 0 0;
        font-size: 1.1rem;
        line-height: 1.6;
        color: #555;
    }

    .steps {
        display: flex;
        flex-direction: column;
        max-width: 1100px;
        margin: 0 auto;
    }

    .step{
        display: grid;
        grid-template-columns: 96px 1fr;
        gap: 28px;
        padding: 48px 0;
        border-bottom: 1px solid #e8e8e8;
        transition: border-color 0.25s ease;
    }

    .step-marker {
        position: relative;
        display: flex;
        align-items: flex-start;
        padding-right: 22px;
    }

    .step-marker::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 2px;
        height: 100%;
        background: #d6d6d6;
        transition: background 0.25s ease;
    }

    .step-marker::before {
        content: "";
        position: absolute;
        top: 8px;
        right: -9px;
        width: 18px;
        height: 18px;
        border: 2px solid #111;
        background: #f5f5f5;
        border-radius: 50%;
        z-index: 2;
        transition: background 0.25s ease, transform 0.25s ease;
    }

    .step-number {
        font-size: 1.7rem;
        font-weight: 700;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        transition: transform 0.25s ease;
        color: #111;
    }

    .step-content h3 {
        margin: 0 0 10px;
        font-size: clamp(1.6rem, 2vw, 2.3rem);
        line-height: 1;
        letter-spacing: -0.03em;
        transition: transform 0.25s ease;
    }

    .step-content p {
        margin: 0;
        max-width: 520px;
        color: #666;
        line-height: 1.6;
        font-size: 1.05rem;
        transition: color 0.25s ease;
    }

    .step:hover {
        border-color: #111;
    }

    .step:hover .step-marker::after {
        background: #111;
    }

    .step:hover .step-marker::before {
        background: #111;
        transform: scale(1.08);
    }

    .step:hover .step-number,
    .step:hover .step-content h3 {
        transform: translateX(4px);
    }

    .step:hover .step-content p {
        color: #333;
    }

    .section-heading,
    .step {
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 0.8s ease,
            transform 0.8s ease;
        transition-delay: var(--delay, 0s);
    }

    .section-heading.visible,
    .step.visible {
        opacity: 1;
        transform: translateY(0);
    }

@media (max-width: 700px) {

.why-studio { padding: 56px 20px; }
.section-heading { margin-bottom: 28px; }
.section-heading h2 { font-size: 2.2rem; line-height: 1.05; }
.section-heading p { font-size: 1rem; }
.step { grid-template-columns: 38px minmax(0,1fr); gap: 18px; padding: 22px 0; }
.step-marker { padding-right: 12px; }
.step-marker::before { width: 10px; height: 10px; right: -6px; }
.step-number { font-size: 1.1rem; }
.step-content h3 { font-size: 1.45rem; }
.step-content p { font-size: 1rem; }

}
</style>

<script>
const observer = new IntersectionObserver(
  (entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  },
  {
    threshold: 0.15,
  }
);

document.querySelectorAll('.section-heading').forEach((el) => {
  observer.observe(el);
});

document.querySelectorAll<HTMLElement>('.step').forEach((el, index) => {
  el.style.setProperty('--delay', `${index * 0.12}s`);
  observer.observe(el);
});
</script>