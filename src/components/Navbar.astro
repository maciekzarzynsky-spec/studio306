---
import { assetUrl } from "../lib/assetUrl";
---

<header class="navbar">
  <a class="navbar__logo" href={assetUrl("")} aria-label="Studio 306 — strona główna">
    <img src={assetUrl("images/logo.png")} alt="" />
    <span class="navbar__name">Studio 306</span>
  </a>

  <nav class="navbar__nav" aria-label="Główna nawigacja">
    <a href={assetUrl("#oferta")}>Oferta</a>
    <a href={assetUrl("#realizacje")}>Realizacje</a>
    <a href={assetUrl("#o-nas")}>O nas</a>
    <a href={assetUrl("#kontakt")}>Kontakt</a>
  </nav>

  <a class="navbar__cta" href={assetUrl("#kontakt")}>
    Wyceń projekt
  </a>
  <details class="mobile-menu">
    <summary aria-label="Menu nawigacji"><span></span><span></span><span></span></summary>
    <nav aria-label="Nawigacja mobilna">
      <a href={assetUrl("#oferta")}>Oferta</a>
      <a href={assetUrl("#realizacje")}>Realizacje</a>
      <a href={assetUrl("#o-nas")}>O nas</a>
      <a href={assetUrl("#kontakt")}>Kontakt</a>
    </nav>
  </details>
</header>
<script>
 const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
 menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
 document.addEventListener('keydown', event => {
   if (event.key === 'Escape' && menu?.open) {
     menu.open = false;
     menu.querySelector('summary')?.focus();
   }
 });
</script>

<style>
.mobile-menu { display: none; }
@media (max-width: 900px) {
 .navbar { height: 76px; }
 .navbar__cta { display: none; }
 .mobile-menu { display: block; justify-self: end; }
 .mobile-menu summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: flex; flex-direction: column; gap: 6px; align-items: center; justify-content: center; }
 .mobile-menu summary::-webkit-details-marker { display: none; }
 .mobile-menu summary span { display: block; width: 24px; height: 2px; background: #111; }
 .mobile-menu nav { position: absolute; top: 100%; left: 0; right: 0; background: #fff; padding: 12px 24px 24px; box-shadow: 0 16px 24px #0002; display: grid; }
 .mobile-menu nav a { color: #111; font-size: 1.1rem; text-decoration: none; padding: 14px 0; border-bottom: 1px solid #eee; }
}

  .navbar {
    position: relative;
    z-index: 100;

    width: 100%;
    height: 96px;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;

    padding: 0 clamp(32px, 4vw, 64px);

    background: #fff;
    border-bottom: 1px solid #ececec;

    box-sizing: border-box;
  }

  .navbar__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #111;
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar__name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .navbar__logo img {
    width: 42px;
    height: 42px;
    display: block;
  }

  .navbar__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 42px;
  }

  .navbar__nav a {
    color: #111;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: opacity .2s;
  }

  .navbar__nav a:hover {
    opacity: .55;
  }

  .navbar__cta {
    justify-self: end;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 12px 24px;

    border: 2px solid #111;
    border-radius: 999px;

    color: #111;
    text-decoration: none;
    font-weight: 600;

    white-space: nowrap;

    transition: .2s;
  }

  .navbar__cta:hover {
    background: #111;
    color: #fff;
  }

  @media (max-width: 900px) {

    .navbar {
      grid-template-columns: auto auto;
      padding: 0 24px;
    }

    .navbar__nav {
      display: none;
    }

    .navbar__logo img {
      width: 36px;
      height: 36px;
    }

    .navbar__cta {
      padding: 10px 18px;
      font-size: .9rem;
    }

  }
  @media (max-width: 380px) {
    .navbar {
      padding: 0 16px;
      column-gap: 12px;
    }

    .navbar__logo {
      gap: 8px;
    }

    .navbar__name {
      font-size: 1.1rem;
    }

    .navbar__cta {
      padding: 10px 12px;
    }
  }
@media (max-width: 900px) { .navbar { height: 76px; } .navbar__cta { display: none; } }
</style> 